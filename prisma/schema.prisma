// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Enums
enum Role {
  STAGIAIRE
  ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model User {
  id            String          @id @default(uuid())
  name          String
  email         String          @unique
  role          Role            @default(STAGIAIRE)
  accountStatus AccountStatus   @default(PENDING)
  validatedBy   User?           @relation("UserValidation", fields: [validatedById], references: [id])
  validatedById String?
  tasks         Task[]
  createdTasks  Task[]          @relation("CreatedTasks")
  projects      Project[]       @relation("UserProjects")
  userProjects  ProjectUser[]
  validatedUsers User[]         @relation("UserValidation") // relation inverse
}

model Project {
  id          String       @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tasks       Task[]
  inviteCode  String       @unique
  createdById String
  createdBy   User         @relation("UserProjects", fields: [createdById], references: [id])
  users       ProjectUser[]
}

model Task {
  id                  String   @id @default(uuid())
  name                String
  description         String
  status              String   @default("To Do")
  dueDate             DateTime?
  projectId           String
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user                User?    @relation(fields: [userId], references: [id])
  userId              String?
  createdAt           DateTime @default(now())           
  createdById         String
  createdBy           User     @relation("CreatedTasks", fields: [createdById], references: [id])
  solutionDescription String?
}

model ProjectUser {
  id        String   @id @default(uuid())
  userId    String
  projectId String
  user      User     @relation(fields: [userId], references: [id])
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@unique([userId, projectId])
}

